CC= gcc -c
LINK= gcc
AR= ar

DEBUG= 1

PLATFORM= x64

#BUILD= Debug
#OFLAGS += -O0 -g -D_DEBUG

BUILD= Release
OFLAGS += -O2 -s -DNDEBUG

OUTPATH= ./bin/$(PLATFORM)/$(BUILD)
#OUTPATH= ./bin/

CFLAGS= $(OFLAGS) -maix64
AFLAGS= -X64 rvs  

SRCS= adler32.c compress.c crc32.c gzio.c uncompr.c deflate.c trees.c \
       zutil.c inflate.c infblock.c inftrees.c infcodes.c infutil.c inffast.c

all: libz.a
     
libz.a: $(SRCS)
	mkdir -p $(OUTPATH)
	$(CC) $(CFLAGS) -o $(OUTPATH)/adler32.o adler32.c
	$(CC) $(CFLAGS) -o $(OUTPATH)/compress.o compress.c
	$(CC) $(CFLAGS) -o $(OUTPATH)/crc32.o crc32.c
	$(CC) $(CFLAGS) -o $(OUTPATH)/gzio.o gzio.c
	$(CC) $(CFLAGS) -o $(OUTPATH)/uncompr.o uncompr.c
	$(CC) $(CFLAGS) -o $(OUTPATH)/deflate.o deflate.c
	$(CC) $(CFLAGS) -o $(OUTPATH)/trees.o trees.c
	$(CC) $(CFLAGS) -o $(OUTPATH)/zutil.o zutil.c
	$(CC) $(CFLAGS) -o $(OUTPATH)/inflate.o inflate.c
	$(CC) $(CFLAGS) -o $(OUTPATH)/infblock.o infblock.c
	$(CC) $(CFLAGS) -o $(OUTPATH)/inftrees.o inftrees.c
	$(CC) $(CFLAGS) -o $(OUTPATH)/infcodes.o infcodes.c
	$(CC) $(CFLAGS) -o $(OUTPATH)/infutil.o infutil.c
	$(CC) $(CFLAGS) -o $(OUTPATH)/inffast.o inffast.c
	
	$(AR) $(AFLAGS) $(OUTPATH)/libz.a $(OUTPATH)/adler32.o $(OUTPATH)/compress.o $(OUTPATH)/crc32.o $(OUTPATH)/gzio.o $(OUTPATH)/uncompr.o\
	$(OUTPATH)/deflate.o $(OUTPATH)/trees.o $(OUTPATH)/zutil.o $(OUTPATH)/inflate.o $(OUTPATH)/infblock.o $(OUTPATH)/inftrees.o\
	$(OUTPATH)/infcodes.o $(OUTPATH)/infutil.o $(OUTPATH)/inffast.o
	